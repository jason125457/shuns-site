---
import CoverCard from '../components/CoverCard.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import InstagramGrid from '../components/InstagramGrid.astro';
import ProjectCard from '../components/ProjectCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCovers, getPhotos, getProjects } from '../lib/content';

const YOUTUBE_CHANNEL = 'https://www.youtube.com/@shun1989';
const INSTAGRAM_PROFILE = 'https://www.instagram.com/shun__098/';

const [covers, projects, photos] = await Promise.all([getCovers(), getProjects(), getPhotos()]);
---

<BaseLayout>
  <Hero />

  <section id="covers" class="container section" aria-labelledby="covers-title">
    <p class="meta">01 ▸ covers ▸ {covers.length}</p>
    <h2 id="covers-title">翻唱</h2>
    {covers.length === 0 ? (
      <p class="placeholder">還沒有加入翻唱。</p>
    ) : (
      <div class="cover-grid">
        {covers.map((cover) => (
          <CoverCard cover={cover} />
        ))}
      </div>
    )}
    <a class="button more" href={YOUTUBE_CHANNEL} target="_blank" rel="noopener">
      <Icon name="youtube-logo" size={18} />
      更多翻唱在 YouTube
      <Icon name="arrow-up-right" size={16} />
      <span class="sr-only">（另開新視窗）</span>
    </a>
  </section>

  <section id="projects" class="container section" aria-labelledby="projects-title">
    <p class="meta">02 ▸ projects ▸ {projects.length}</p>
    <h2 id="projects-title">AI 專案</h2>
    <div class="project-grid">
      {projects.map((project, i) => (
        <ProjectCard project={project} index={i + 1} />
      ))}
    </div>
  </section>

  <section id="photos" class="container section" aria-labelledby="photos-title">
    <p class="meta">03 ▸ photos ▸ {photos.length}</p>
    <h2 id="photos-title">攝影</h2>
    {photos.length === 0 ? (
      <p class="placeholder">還沒有加入照片。</p>
    ) : (
      <InstagramGrid photos={photos} />
    )}
    <a class="button more" href={INSTAGRAM_PROFILE} target="_blank" rel="noopener">
      <Icon name="instagram-logo" size={18} />
      更多作品在 Instagram
      <Icon name="arrow-up-right" size={16} />
      <span class="sr-only">（另開新視窗）</span>
    </a>
  </section>

  <section id="about" class="container section" aria-labelledby="about-title">
    <p class="meta">04 ▸ about</p>
    <h2 id="about-title">關於</h2>
    <p class="placeholder">建置中：自我介紹與聯絡方式</p>
  </section>
</BaseLayout>

<script>
  import { enhanceYouTubeFacades } from '../lib/youtube-player';

  enhanceYouTubeFacades();
</script>

<style>
  .section {
    padding-block: var(--space-8);
    border-top: 1px solid var(--border);
  }

  .section h2 {
    margin-block: var(--space-1) var(--space-4);
    font-family: var(--font-serif-tc);
    font-size: var(--text-xl);
  }

  .cover-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: var(--space-6) var(--space-3);
  }

  .project-grid {
    display: grid;
    gap: var(--space-8);
  }

  @media (min-width: 768px) {
    .project-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-6);
    }
  }

  .more {
    margin-top: var(--space-6);
  }

  .placeholder {
    color: var(--fg-muted);
  }

  @media (min-width: 640px) {
    .section {
      padding-block: var(--space-12);
    }
  }
</style>
