---
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCovers, getPhotos, getProjects } from '../lib/content';

// Sections still show placeholder layouts; phase 3 (PLAN.md) replaces them with the real cards.
const [covers, projects, photos] = await Promise.all([getCovers(), getProjects(), getPhotos()]);
---

<BaseLayout>
  <Hero />

  <section id="covers" class="container section" aria-labelledby="covers-title">
    <p class="meta">01 ▸ covers ▸ {covers.length}</p>
    <h2 id="covers-title">翻唱</h2>
    {covers.length === 0 ? (
      <p class="placeholder">還沒有加入翻唱。</p>
    ) : (
      <ul>
        {covers.map((cover) => (
          <li>
            {cover.title} ▸ {cover.artist}
          </li>
        ))}
      </ul>
    )}
  </section>

  <section id="projects" class="container section" aria-labelledby="projects-title">
    <p class="meta">02 ▸ projects ▸ {projects.length}</p>
    <h2 id="projects-title">AI 專案</h2>
    <div class="project-grid">
      {projects.map((project, i) => (
        <ProjectCard project={project} index={i + 1} />
      ))}
    </div>
  </section>

  <section id="photos" class="container section" aria-labelledby="photos-title">
    <p class="meta">03 ▸ photos ▸ {photos.length}</p>
    <h2 id="photos-title">攝影</h2>
    {photos.length === 0 ? (
      <p class="placeholder">還沒有加入照片。</p>
    ) : (
      <ul>
        {photos.map((photo) => (
          <li>
            <a href={photo.instagram.permalink}>{photo.caption ?? photo.id}</a>
          </li>
        ))}
      </ul>
    )}
  </section>

  <section id="about" class="container section" aria-labelledby="about-title">
    <p class="meta">04 ▸ about</p>
    <h2 id="about-title">關於</h2>
    <p class="placeholder">建置中：自我介紹與聯絡方式</p>
  </section>
</BaseLayout>

<style>
  .section {
    padding-block: var(--space-8);
    border-top: 1px solid var(--border);
  }

  .section h2 {
    margin-block: var(--space-1) var(--space-2);
    font-family: var(--font-serif-tc);
    font-size: var(--text-xl);
  }

  .section ul {
    max-width: var(--prose-max);
    padding-left: 1.25em;
  }

  .project-grid {
    display: grid;
    gap: var(--space-8);
    margin-top: var(--space-4);
  }

  @media (min-width: 768px) {
    .project-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-6);
    }
  }

  .placeholder {
    color: var(--fg-muted);
  }

  @media (min-width: 640px) {
    .section {
      padding-block: var(--space-12);
    }
  }
</style>
