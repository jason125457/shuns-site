---
// Phosphor regular icons, inlined at build time so they inherit currentColor.
import arrowUpRight from '@phosphor-icons/core/assets/regular/arrow-up-right.svg?raw';
import camera from '@phosphor-icons/core/assets/regular/camera.svg?raw';
import githubLogo from '@phosphor-icons/core/assets/regular/github-logo.svg?raw';
import instagramLogo from '@phosphor-icons/core/assets/regular/instagram-logo.svg?raw';
import moon from '@phosphor-icons/core/assets/regular/moon.svg?raw';
import musicNotes from '@phosphor-icons/core/assets/regular/music-notes.svg?raw';
import play from '@phosphor-icons/core/assets/regular/play.svg?raw';
import sparkle from '@phosphor-icons/core/assets/regular/sparkle.svg?raw';
import sun from '@phosphor-icons/core/assets/regular/sun.svg?raw';
import youtubeLogo from '@phosphor-icons/core/assets/regular/youtube-logo.svg?raw';

const icons = {
  'arrow-up-right': arrowUpRight,
  camera,
  'github-logo': githubLogo,
  'instagram-logo': instagramLogo,
  moon,
  'music-notes': musicNotes,
  play,
  sparkle,
  sun,
  'youtube-logo': youtubeLogo,
};

export type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 20, class: className } = Astro.props;
const svg = icons[name].replace(
  '<svg ',
  `<svg width="${size}" height="${size}" aria-hidden="true" focusable="false" `,
);
---

<span class:list={['icon', className]} set:html={svg} />

<style>
  .icon {
    display: inline-flex;
    flex-shrink: 0;
  }
</style>
