{
  // Static assets only: Cloudflare serves dist/ directly, no Worker code runs.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shuns-site",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "none",
  },
  // Personal Feed lives on feed.shuns.site; both the apex and www serve this site.
  "routes": [
    { "pattern": "shuns.site", "custom_domain": true },
    { "pattern": "www.shuns.site", "custom_domain": true },
  ],
}
